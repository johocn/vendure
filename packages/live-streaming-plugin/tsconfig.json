{
    "compilerOptions": {
        "module": "commonjs",
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "target": "ES2022",
        "sourceMap": false,
        "outDir": "./lib",
        "baseUrl": "./",
        "strict": true,
        "strictPropertyInitialization": false,
        "skipLibCheck": true
    },
    "include": ["index.ts", "src/**/*.ts"],
    "exclude": ["node_modules"]
}
