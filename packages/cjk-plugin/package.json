{
    "name": "@vendure/cjk-plugin",
    "version": "0.0.1",
    "license": "GPL-3.0-or-later",
    "main": "lib/index.js",
    "types": "lib/index.d.ts",
    "files": [
        "lib/**/*",
        "src/i18n/**/*.json"
    ],
    "scripts": {
        "watch": "tsc -p ./tsconfig.build.json --watch",
        "build": "rimraf lib && tsc -p ./tsconfig.build.json && node -e \"require('fs').cpSync('src/i18n','lib/src/i18n',{recursive:true})\"",
        "lint": "eslint --fix .",
        "test": "vitest --config vitest.config.mts --run"
    },
    "dependencies": {
        "@nestjs/event-emitter": "^3.1.0",
        "@vendure/coupon-plugin": "0.0.1",
        "@vendure/distribution-plugin": "0.0.1"
    },
    "peerDependencies": {
        "@vendure/common": "^3.6.0",
        "@vendure/core": "^3.6.0"
    },
    "devDependencies": {
        "@vendure/common": "3.6.4",
        "@vendure/core": "3.6.4",
        "rimraf": "^5.0.5",
        "typescript": "5.8.2"
    }
}
